# =============================================================
# ViraEdit Environment Variables
# Copy this file to .env and fill in your values.
# Windows users: paths use forward slashes even on Windows.
# =============================================================

# ── APP ──────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-32-char-string
APP_DEBUG=true

# ── DATABASE (PostgreSQL) ─────────────────────────────────────
# Docker runs PostgreSQL on port 5432
DATABASE_URL=postgresql+asyncpg://viraedit:viraedit_dev_password@localhost:5432/viraedit
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── REDIS ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── OBJECT STORAGE (MinIO — local S3) ─────────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET_NAME=viraedit-media
S3_REGION=us-east-1

# ── AI — OPENAI (Analysis, suggestions, AI editing) ───────────
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_MODEL_PRIMARY=gpt-4o-mini
OPENAI_MODEL_FAST=gpt-4o-mini

# ── Style extraction ────────────────────────────────────────
# EasyOCR on CPU is very slow (5–15 min). Keep false; OpenCV vision is enough.
STYLE_EXTRACT_USE_EASYOCR=false

# ── AI — ELEVENLABS (Speech-to-text — Scribe only) ──────────
# Required for Nepali transcription.
# Create at https://elevenlabs.io/app/settings/api-keys
# - Enable permission: speech_to_text
# - Secret is shown once: either sk_... or a 64-character hex string (NOT a 32-char dashboard ID)
ELEVENLABS_API_KEY=sk_f8ad8fda4c80ec85614a4cc90f8a9817c09f36a3b9657577
ELEVENLABS_STT_MODEL=scribe_v2

# ── AI — ANTHROPIC (Optional — premium hook rewriting only) ───
# Only used when user requests premium quality rewrites.
# Leave blank to skip — app works without it.
ANTHROPIC_API_KEY=

# ── Stock footage (Pexels) — used for B-roll search/insert ─────
PEXELS_API_KEY=
# Skip OpenAI Images API (DALL-E) when your key is chat-only; stock/Gemini still work.
OPENAI_IMAGE_ENABLED=true
# Search Pexels first instead of trying AI image generation.
BROLL_PREFER_STOCK=false
# Install Ollama from https://ollama.com for offline AI
OLLAMA_BASE_URL=http://localhost:11434

# ── AI BUDGET ─────────────────────────────────────────────────
# Maximum AI spend per hour of video (USD)
AI_BUDGET_PER_HOUR_USD=2.00
AI_BUDGET_WARNING_THRESHOLD=0.80
AI_BUDGET_HARD_LIMIT_SWITCH_LOCAL=0.90

# ── AUTH (JWT) ────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-another-random-32-char-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CELERY WORKERS ────────────────────────────────────────────
# IMPORTANT: Always use solo pool on Windows
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_WORKER_POOL=solo

# ── FFMPEG ────────────────────────────────────────────────────
# Leave blank to auto-detect from PATH
# Windows example: C:/ffmpeg/bin/ffmpeg.exe  (use forward slashes)
FFMPEG_PATH=
FFPROBE_PATH=

# ── FONTS (Devanagari — for Nepali captions) ──────────────────
# Windows: fonts install to C:\Windows\Fonts
# Run scripts\install_fonts.bat to install them automatically
DEVANAGARI_FONT_PATH=C:/Windows/Fonts/NotoSansDevanagari-Regular.ttf
DEVANAGARI_FONT_BOLD_PATH=C:/Windows/Fonts/NotoSansDevanagari-Bold.ttf

# ── FRONTEND ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_MINIO_URL=http://localhost:9000

# ── TRANSCRIPTION (Nepali via ElevenLabs Scribe) ───────────────
# Always "ne" for Nepali. Do not change.
WHISPER_LANGUAGE=ne
# scribe_v2 = batch STT with word-level timestamps
WHISPER_MODEL=scribe_v2

# ── STORAGE PATHS (Windows — use forward slashes) ─────────────
TEMP_DIR=C:/Users/dell/AppData/Local/Temp/viraedit
UPLOAD_DIR=C:/Users/dell/apps/viraedit/uploads
RENDER_OUTPUT_DIR=C:/Users/dell/apps/viraedit/renders

# ── LOGGING ───────────────────────────────────────────────────
LOG_LEVEL=DEBUG
LOG_FORMAT=pretty
LOG_FILE=logs/viraedit.log
