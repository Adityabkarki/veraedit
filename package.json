{
  "name": "viraedit",
  "version": "0.1.0",
  "private": true,
  "description": "AI-native video editing platform for Nepali content creators",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rimraf node_modules",
    "web": "turbo run dev --filter=web",
    "api": "cd apps/api && .venv\\Scripts\\python.exe -m uvicorn main:app --reload --host 127.0.0.1 --port 8000"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "turbo": "^2.9.18"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.8.2"
}
